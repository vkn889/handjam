{
  "name": "handjam",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"next dev\" \"npm run dev:api\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "dev:web": "next dev",
    "dev:api": "uv run --no-project --python 3.12 --with-requirements requirements.txt --with uvicorn uvicorn api.index:app --reload --reload-dir api --port 8000",
    "emulators": "npx -y firebase-tools@14 emulators:start --project demo-handjam"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.1",
    "@paper-design/shaders": "^0.0.82",
    "@radix-ui/react-slot": "^1.5.0",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^13.1.0",
    "framer-motion": "^14.6.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
